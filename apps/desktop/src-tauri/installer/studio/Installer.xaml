<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Papier · Instalação" Width="940" Height="600" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#090D13" Foreground="#EAF1FC" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#8799B2"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#D5E1F2"/><Setter Property="Background" Value="#192331"/><Setter Property="BorderBrush" Value="#334459"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9EBBDD"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E7F3FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1621"/><Setter Property="Foreground" Value="#AFC0D7"/><Setter Property="BorderBrush" Value="#293649"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="11"/><Setter Property="CaretBrush" Value="#EAF1FC"/><Setter Property="SelectionBrush" Value="#57769D"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#B0C0D5"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Switch" Width="30" Height="17" CornerRadius="8" Background="#233044" Margin="0,0,10,0"><Ellipse x:Name="Knob" Width="11" Height="11" Fill="#8295AF" HorizontalAlignment="Left" Margin="3,0,0,0"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="#B7CDE9"/><Setter TargetName="Knob" Property="Fill" Value="#142033"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="#F0F6FF"/><Setter TargetName="Switch" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border BorderBrush="#354152" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
 <Viewbox Stretch="Uniform"><Grid Width="938" Height="598">
  <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
   <Ellipse x:Name="Haze" Width="630" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,0,0,0" Opacity="0.65"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#334D72" Offset="0"/><GradientStop Color="#00151D2C" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
   <Ellipse Width="560" Height="330" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-100" Opacity="0.45"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#313449" Offset="0"/><GradientStop Color="#00090D13" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
   <Path Data="M-100,440 C220,440 330,250 430,-60" Stroke="#1B2C42" StrokeThickness="1"/>
   <Path Data="M-100,450 C235,450 340,250 443,-60" Stroke="#102035" StrokeThickness="1"/>
  </Grid>
  <Grid Grid.Column="0" Margin="40,43,30,35">
   <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="85"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal"><TextBlock Text="Papier" FontSize="24" FontWeight="SemiBold"/><Border BorderBrush="#3A4C66" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="13,4,0,12"><TextBlock Text="DESKTOP" FontSize="8" Foreground="#92A5BF"/></Border></StackPanel>
   <Grid Grid.Row="1" x:Name="BrandObject" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
    <Border Width="202" Height="235" CornerRadius="13" BorderBrush="#405675" BorderThickness="1" Opacity="0.45" RenderTransformOrigin="0.5,0.5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#223246"/><GradientStop Color="#090E17" Offset="1"/></LinearGradientBrush></Border.Background><Border.RenderTransform><TransformGroup><RotateTransform Angle="-15"/><TranslateTransform X="-15" Y="9"/></TransformGroup></Border.RenderTransform></Border>
    <Border Width="202" Height="235" CornerRadius="13" BorderBrush="#60718A" BorderThickness="1" RenderTransformOrigin="0.5,0.5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#344052"/><GradientStop Color="#151E2C" Offset="0.4"/><GradientStop Color="#0C131E" Offset="1"/></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="16" Opacity="0.65" Color="#000000"/></Border.Effect><Border.RenderTransform><RotateTransform Angle="5"/></Border.RenderTransform>
     <Grid><Path x:Name="BrandP" Width="110" Height="137" Stretch="Uniform" Data="M7,5 L25,5 33,13 33,23 25,31 15,31 15,36 7,36 Z M15,13 L15,23 25,23 25,13 Z"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F1F6FF" Offset="0"/><GradientStop x:Name="Pearl" Color="#A2BBD8" Offset="0.35"/><GradientStop Color="#F4FBFF" Offset="0.5"/><GradientStop Color="#7F9FBD" Offset="0.65"/><GradientStop Color="#C4C2DA" Offset="1"/></LinearGradientBrush></Path.Fill><Path.Effect><DropShadowEffect BlurRadius="13" ShadowDepth="3" Color="#6385B6" Opacity="0.35"/></Path.Effect></Path><TextBlock Text="P / YOUR PRIVATE WORKSPACE" FontSize="6" Foreground="#7187A4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"/></Grid>
    </Border>
   </Grid>
   <StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="Menos atrito.&#x0a;Mais espaço para criar." FontSize="22" FontWeight="Light" LineHeight="29"/><TextBlock Text="PDF, REIMAGINADO." FontSize="8" Foreground="#6D829F" Margin="0,14,0,0"/></StackPanel>
  </Grid>
  <Border Grid.Column="1" Margin="0,64,38,32" BorderBrush="#233246" BorderThickness="1,0,0,0" Padding="35,0,0,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Grid x:Name="SetupPanel">
     <StackPanel><TextBlock Text="01  /  SEU NOVO ESPAÇO" Foreground="#93A7C2" FontSize="9" Margin="0,5,0,20"/><TextBlock Text="Tudo pronto&#x0a;para começar." FontSize="32" FontWeight="SemiBold" LineHeight="39"/><TextBlock Text="Ferramentas precisas. Documentos privados.&#x0a;Uma instalação, e o espaço é seu." Foreground="{StaticResource Muted}" FontSize="12" LineHeight="20" Margin="0,18,0,25"/>
      <TextBlock Text="LOCAL DE INSTALAÇÃO" Foreground="#6D829F" FontSize="8" Margin="0,0,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBox x:Name="InstallPath" AutomationProperties.Name="Local de instalação"/><Button Grid.Column="1" x:Name="Browse" Content="Alterar" Padding="8,5" Margin="7,0,0,0"/></Grid>
      <TextBlock x:Name="Existing" Text="Somente para este usuário. Sem conta obrigatória." FontSize="10" Foreground="#6D829F" TextWrapping="Wrap" Margin="0,9,0,20"/>
      <CheckBox x:Name="Shortcut" Content="Criar atalhos no menu Iniciar e na área de trabalho" IsChecked="True"/>
      <TextBlock x:Name="SetupError" Foreground="#EDACA9" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
     <Button x:Name="Install" Content="Instalar Papier     →" VerticalAlignment="Bottom" Height="43" Background="#DAE7F8" Foreground="#132237" BorderBrush="#E9F2FF" FontWeight="SemiBold" Margin="0,0,0,18"/>
    </Grid>
    <Grid x:Name="ProgressPanel" Visibility="Collapsed">
     <StackPanel><TextBlock Text="02  /  PREPARANDO SEU ESPAÇO" Foreground="#93A7C2" FontSize="9" Margin="0,5,0,22"/><TextBlock Text="Um instante.&#x0a;Estamos chegando." FontSize="31" FontWeight="SemiBold" LineHeight="39"/>
      <StackPanel Orientation="Horizontal" Margin="0,32,0,12" VerticalAlignment="Center"><TextBlock x:Name="Percent" Text="0" FontSize="62" FontFamily="Segoe UI Light"/><TextBlock Text="%" FontSize="22" Foreground="#738BAA" VerticalAlignment="Bottom" Margin="8,0,0,13"/></StackPanel>
      <Border x:Name="Track" Height="4" Background="#223044" CornerRadius="2"><Border x:Name="Fill" Width="0" Height="4" HorizontalAlignment="Left" CornerRadius="2"><Border.Background><LinearGradientBrush><GradientStop Color="#6A90BE"/><GradientStop Color="#E7F5FF" Offset="1"/></LinearGradientBrush></Border.Background></Border></Border>
      <TextBlock x:Name="Phase" Text="Verificando os componentes do Windows…" FontSize="12" Foreground="#B9CBE2" Margin="0,16,0,7"/><TextBlock x:Name="ProgressDetail" Text="O progresso acompanha os arquivos realmente instalados." FontSize="10" Foreground="#6D829F" TextWrapping="Wrap"/>
      <Border BorderThickness="0,1,0,0" BorderBrush="#203047" Margin="0,28,0,0" Padding="0,18,0,0"><TextBlock Text="Seus documentos permanecem no seu computador.&#x0a;Nenhum arquivo pessoal é enviado na instalação." FontSize="11" Foreground="#7D91AD" LineHeight="19"/></Border>
     </StackPanel>
    </Grid>
    <Grid x:Name="ReadyPanel" Visibility="Collapsed">
     <StackPanel><TextBlock Text="03  /  BEM-VINDO AO PAPIER" Foreground="#93A7C2" FontSize="9" Margin="0,5,0,28"/><TextBlock Text="O espaço&#x0a;agora é seu." FontSize="36" FontWeight="SemiBold" LineHeight="44"/><TextBlock Text="Instalação concluída. Abra seu primeiro PDF&#x0a;ou dê forma a uma ideia em uma página nova." FontSize="12" Foreground="#91A6C1" LineHeight="21" Margin="0,22,0,28"/>
      <Border BorderThickness="1" BorderBrush="#33475F" CornerRadius="9" Background="#142131" Padding="18"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="23" Foreground="#CADFF8" Margin="0,0,15,0"/><StackPanel><TextBlock Text="100% · Papier instalado" FontSize="12"/><TextBlock Text="Editor, fontes e ferramentas de PDF prontos." FontSize="10" Foreground="#7E95B4" Margin="0,5,0,0"/></StackPanel></StackPanel></Border>
     </StackPanel><Button x:Name="Launch" Content="Abrir Papier     ↗" VerticalAlignment="Bottom" Height="43" Background="#DAE7F8" Foreground="#132237" FontWeight="SemiBold" Margin="0,0,0,18"/>
    </Grid>
    <Grid Grid.Row="1"><TextBlock x:Name="Footnote" Text="LOCAL POR PRINCÍPIO." Foreground="#627894" FontSize="8" VerticalAlignment="Bottom"/><TextBlock Text="1.0.3  /  WINDOWS" Foreground="#627894" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
   </Grid>
  </Border>
  <Grid x:Name="TitleArea" Grid.ColumnSpan="2" Height="34" VerticalAlignment="Top" Background="Transparent"><TextBlock Text="PAPIER  /  SETUP" Foreground="#536A87" FontSize="8" Margin="18,12,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" Content="−" Background="Transparent" BorderThickness="0" Width="36" Padding="0"/><Button x:Name="Close" Content="×" Background="Transparent" BorderThickness="0" Width="36" Padding="0"/></StackPanel></Grid>
 </Grid></Viewbox></Border>
</Window>
