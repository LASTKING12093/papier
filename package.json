{
  "name": "pdf-editor-workspace",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.ts",
    "desktop": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "test": "vitest run",
    "check": "tsc -p apps/desktop/tsconfig.json --noEmit",
    "package": "node scripts/build-release.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
